# ===== iCG1 — نسخ هذا الملف إلى .env ولا ترفعه أبداً إلى GitHub =====
# في Vercel: ضع هذه القيم من Settings ← Environment Variables (الإنتاج فقط)،
# وليس في الكود. المتغيرات التي تبدأ بـ EXPO_PUBLIC_ / VITE_ تُحقن في المتصفح،
# فلا تضع فيها أسرارًا.

# --- عام (يصل للمتصفح — مفتاح anon/publishable فقط) ---
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_KEY=

# --- خادم فقط (تدعم دوال /api — لا تُحقن في الحزمة أبداً) ---
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# SUPABASE_SERVICE_ROLE_KEY=   # بديل لـ SUPABASE_SECRET_KEY
SESSION_SECRET=            # سلسلة عشوائية طويلة لتوقيع الجلسات (32 حرفًا فأكثر)
CODE_HMAC_SECRET=          # سلسلة عشوائية طويلة لأكواد التحقق
ADMIN_FALLBACK_PASSWORD=   # كلمة سر احتياطية للوحة (الأفضل: app_config في القاعدة)
OBS_STUDIO_TOKEN=          # توكن رابط OBS (اختياري)

# --- خدمات خارجية (قيّدها بنطاق icg1.vercel.app من لوحة كل خدمة) ---
GEMINI_API_KEY=
PEXELS_API_KEY=
LOGO_DEV_TOKEN=
